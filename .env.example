# Relay environment. Copy to a private file outside the checkout; do not commit it.
NODE_ENV=production
HOST=127.0.0.1
PORT=3005
DB_PROVIDER=pglite
DATA_DIR=/var/lib/kissopen/relay
PGLITE_DIR=/var/lib/kissopen/relay/pglite
PUBLIC_URL=https://your-kissopen.example
COMMUNITY_AUTH_PUBLIC_URL=https://your-kissopen.example
HANDY_MASTER_SECRET=
COMMUNITY_GITHUB_CLIENT_ID=
COMMUNITY_GITHUB_CLIENT_SECRET=
COMMUNITY_GOOGLE_CLIENT_ID=
COMMUNITY_GOOGLE_CLIENT_SECRET=
COMMUNITY_NODELOC_CLIENT_ID=
COMMUNITY_NODELOC_CLIENT_SECRET=
# Optional, independently built client; not a source checkout.
# KISSOPEN_STATIC_DIR=/var/lib/kissopen/webapp
