# Account service environment. Separate database and independently generated secret.
CN_MODE=production
CN_ADDR=127.0.0.1:8081
CN_PUBLIC_URL=https://your-kissopen.example
CN_DATABASE=postgres://kissopen:REPLACE_WITH_PRIVATE_PASSWORD@127.0.0.1:5432/kissopen_accounts?sslmode=disable
CN_IMAGE_DIR=/var/lib/kissopen/accounts/images
CN_SECRET=
KISSOPEN_COMMUNITY_AUTH_URL=http://127.0.0.1:3005
CN_WORKSPACE_URL=https://your-kissopen.example
# Catalog archives are operator-supplied deployment assets, not user data.
KISSOPEN_PLUGIN_CATALOG=/var/lib/kissopen/plugin-catalog
# Exact stable OAuth identity IDs only; nobody is made admin automatically.
# KISSOPEN_ADMIN_IDENTITIES=
# List exact public/development browser origins only when needed.
# CN_CLIENT_ORIGINS=https://your-kissopen.example
